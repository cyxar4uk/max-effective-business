# Прод: один домен, TLS от Let's Encrypt выпускается автоматически.
# MAX принимает вебхук только на 443 и только с сертификатом доверенного УЦ.
{
	email {$ACME_EMAIL}
	# Журнал ошибок (например, сервер недоступен при выкатке) тоже без заголовков: в них initData и секрет вебхука
	log default {
		format filter {
			wrap json
			request>headers delete
			request>uri regexp ^(/api/practice-files/)[^/?]+ ${1}…
		}
	}
}

{$DOMAIN} {
	encode zstd gzip

	# API мини-приложения и вебхук бота
	handle /api/* {
		reverse_proxy meb-server:3000
	}
	handle /bot/* {
		reverse_proxy meb-server:3000
	}

	# Мини-приложение: статика за nginx, контейнер meb-miniapp
	handle {
		reverse_proxy meb-miniapp:80
	}

	# В журнал доступа не пишем заголовки (в них initData) и токен ссылки на документ практики (ключ к файлу на 15 минут)
	log {
		format filter {
			request>headers delete
			request>uri regexp ^(/api/practice-files/)[^/?]+ ${1}…
		}
	}
}

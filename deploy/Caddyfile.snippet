# Блок для Caddy, который уже работает на сервере: дописать в конец его Caddyfile и заменить домен.
# Сертификат Caddy выпустит сам. Проверить и применить без остановки соседних сайтов:
#   caddy validate --config /etc/caddy/Caddyfile && caddy reload --config /etc/caddy/Caddyfile
# Caddy в Docker — те же команды через `docker exec <контейнер>`, под systemd — `systemctl reload caddy`.
# Контейнер НЕ перезапускать: с ошибкой в файле Caddy не поднимется и уронит все сайты на нём, а reload с ошибкой
# просто откажет, и продолжит работать старая конфигурация.
# Caddy в Docker-контейнере: подключить его к сети meb-edge и заменить 127.0.0.1:3000 на meb-server:3000
# (Caddy разрешает имя при каждом запросе, поэтому переживёт остановку нашего сервера).
# Синтаксис журнала (`wrap json` + `fields`) проверен на Caddy 2.6 (Ubuntu apt), 2.7 и 2.11.
#
# Важно: журнал ошибок Caddy (например, «сервер недоступен» во время выкатки) по умолчанию пишет заголовки запроса,
# а в них initData и секрет вебхука. Если такого фильтра ещё нет, строки `log default { … }` добавить ВНУТРЬ
# уже существующего глобального блока `{ … }` в начале файла — второй глобальный блок Caddy не примет. Если
# глобального блока нет — поставить этот блок первым в файле:
#   {
#   	log default {
#   		format filter {
#   			wrap json
#   			fields {
#   				request>headers delete
#   			}
#   		}
#   	}
#   }

app.example.ru {
	encode zstd gzip
	handle /api/* {
		reverse_proxy 127.0.0.1:3000
	}
	handle /bot/* {
		reverse_proxy 127.0.0.1:3000
	}
	# Мини-приложение (статика Ильи)
	handle {
		reverse_proxy 127.0.0.1:8080
	}
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
			}
		}
	}
}

# Блок для nginx, который уже работает на сервере. Скопировать в /etc/nginx/sites-available/<домен>,
# заменить app.example.ru на наш поддомен (а 3000 и 8080 — на SERVER_PORT и MINIAPP_PORT, если меняли), включить и
# выпустить сертификат:
#   ln -s /etc/nginx/sites-available/<домен> /etc/nginx/sites-enabled/
#   certbot --nginx -d <домен>          # добавит ssl_certificate и редирект с 80
#   nginx -t && systemctl reload nginx
# MAX принимает вебхук только на 443 с сертификатом доверенного УЦ.

server {
    listen 80;
    server_name app.example.ru;

    # Заголовок с initData в журнал не пишем: формат журнала без заголовков запроса
    access_log /var/log/nginx/max-effective-business.access.log;

    client_max_body_size 1m;

    # Подписанные ссылки на документы практики: токен в адресе — ключ к файлу на 15 минут, в журнал не пишем.
    # ^~ обязателен: без него regex-блок /(api|bot)/ ниже перехватит запрос, и токен попадёт в журнал
    location ^~ /api/practice-files/ {
        access_log off;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # API мини-приложения и вебхук бота → наш сервер (compose.proxy.yaml, SERVER_PORT)
    location ~ ^/(api|bot)/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Мини-приложение → контейнер meb-miniapp (compose.proxy.yaml, MINIAPP_PORT)
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

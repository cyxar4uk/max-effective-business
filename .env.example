# Скопировать в .env и заполнить: cp .env.example .env
# Значения в репозиторий не коммитим. Для локальной проверки хватит любых непустых MAX_BOT_TOKEN и POSTGRES_PASSWORD
# (README, «Запуск одной командой»).

# --- MAX ---
# Токен бота MAX, выдан организаторами. Нужен и серверу (проверка initData), и боту.
MAX_BOT_TOKEN=
# Публичный HTTPS-адрес мини-приложения. Отсюда берётся origin для CORS.
# Пусто в разработке — CORS разрешён для любого origin (кроме NODE_ENV=production).
# В compose сервер работает с NODE_ENV=production: чтобы мини-приложение с localhost:5173 ходило в API из compose,
# задайте MINIAPP_URL=http://localhost:5173
MINIAPP_URL=

# Секрет вебхука бота: 5–256 символов A-Z a-z 0-9 _ -. Сгенерировать: openssl rand -hex 32
# Пусто — вебхук выключен (локальная разработка).
MAX_WEBHOOK_SECRET=

# --- Прод (compose.prod.yaml) ---
# Домен, на который указывает A-запись сервера. Мини-приложение — https://$DOMAIN, вебхук — https://$DOMAIN/bot/webhook
DOMAIN=
# Почта для Let's Encrypt (уведомления о сертификате)
ACME_EMAIL=

# --- PostgreSQL ---
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=

# --- Сервер ---
# Порт сервера на хосте (внутри контейнера всегда 3000)
SERVER_PORT=3000
# Порт мини-приложения на хосте (внутри контейнера 80). На сервере с чужим прокси — любой свободный
MINIAPP_PORT=8080
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Загружать тестовые данные при старте (помечены is_demo / source=demo)
SEED_DEMO=true
# Сколько секунд после auth_date принимаем initData
INIT_DATA_MAX_AGE_SEC=86400
# Число reverse-proxy перед сервером (0 локально, 1 в проде за Caddy/nginx)
TRUST_PROXY=0
# Лимит запросов к /api с одного IP в минуту
RATE_LIMIT_PER_MIN=120
# Порог совпадения для уведомления студента, %
MATCH_NOTIFY_THRESHOLD=60
# Сколько новых мест в день бот присылает студенту (сверх — одна подборка); 0 — без лимита, для живого показа
MATCH_DAILY_LIMIT=3
# Минимальное совпадение для ленты студента, %: места ниже в ленте не показываются (по ссылке и QR открываются)
FEED_MIN_SCORE=40
# Демо-режим: не чаще одного приглашения от демо-компании студенту за столько часов; 0 — без ограничения
DEMO_INVITE_COOLDOWN_HOURS=24

# --- GigaChat: ИИ-черновик карточки места (POST /api/internships/draft) ---
# Authorization key проекта GigaChat API в Studio (developers.sber.ru → проект → «Ключ авторизации»): base64(client_id:client_secret).
# Пусто — черновик собирается по ключевым словам, без модели; в ответе source: "rules", мини-приложение не пишет «ИИ».
# Ключ — секрет: только здесь, не в чате и не в репозитории.
GIGACHAT_AUTH_KEY=
# Версия API: GIGACHAT_API_PERS — физлицо (freemium), GIGACHAT_API_B2B — ИП/юрлицо по пакетам, GIGACHAT_API_CORP — ИП/юрлицо с оплатой по факту
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель: GigaChat-2 (Lite, дешевле и быстрее), GigaChat-2-Pro, GigaChat-2-Max. Список доступных — GET /api/v1/models
GIGACHAT_MODEL=GigaChat-2
# Сколько черновиков в час можно запросить одному пользователю
AI_DRAFT_PER_HOUR=10

# --- Только для локального запуска сервера без Docker (npm run dev) ---
# NODE_ENV=development
# DATABASE_URL=postgres://app:<пароль>@localhost:5432/app

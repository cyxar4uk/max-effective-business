# Скопировать в .env и заполнить. Значения в репозиторий не коммитим.
# Полный список появится вместе с кодом (владелец — Андрей).

# Токен бота MAX, выдан организаторами
MAX_BOT_TOKEN=

# Публичный HTTPS-адрес мини-приложения
MINIAPP_URL=

# PostgreSQL
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=
